{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!src/generated",
			"!src/components/ui",
			"!pnpm-lock.yaml",
			"!drizzle/**/snapshot.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"lucide*",
									"@lucide/**",
									"react-icons",
									"react-icons/**",
									"@heroicons/**",
									"@radix-ui/react-icons",
									"@phosphor-icons/**",
									"phosphor-react",
									"@tabler/icons*",
									"@fortawesome/**",
									"@ant-design/icons*",
									"@mui/icons-material",
									"@mui/icons-material/**"
								],
								"message": "Use @hugeicons/core-free-icons with @hugeicons/react; Hugeicons is the project icon library."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"recommended": true
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/components/**",
				"src/hooks/**",
				"src/features/*/components/**",
				"src/features/*/use-*.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/*.server",
											"**/*.server.*",
											"#/db",
											"#/db/**",
											"#/server/**"
										],
										"message": "UI uses feature query/mutation APIs. Keep storage and server modules behind server functions."
									},
									{
										"group": [
											"lucide*",
											"@lucide/**",
											"react-icons",
											"react-icons/**",
											"@heroicons/**",
											"@radix-ui/react-icons",
											"@phosphor-icons/**",
											"phosphor-react",
											"@tabler/icons*",
											"@fortawesome/**",
											"@ant-design/icons*",
											"@mui/icons-material",
											"@mui/icons-material/**"
										],
										"message": "Use @hugeicons/core-free-icons with @hugeicons/react; Hugeicons is the project icon library."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/features/catalog/*.server.ts",
				"src/features/search/*.server.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"#/db",
											"#/db/**",
											"drizzle-orm",
											"drizzle-orm/**",
											"pg"
										],
										"message": "Redis owns the live catalog; PostgreSQL belongs to accounts and transactions."
									},
									{
										"group": [
											"lucide*",
											"@lucide/**",
											"react-icons",
											"react-icons/**",
											"@heroicons/**",
											"@radix-ui/react-icons",
											"@phosphor-icons/**",
											"phosphor-react",
											"@tabler/icons*",
											"@fortawesome/**",
											"@ant-design/icons*",
											"@mui/icons-material",
											"@mui/icons-material/**"
										],
										"message": "Use @hugeicons/core-free-icons with @hugeicons/react; Hugeicons is the project icon library."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
